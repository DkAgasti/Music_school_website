generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum AdmissionStatus {
  PENDING
  APPROVED
  WAITLISTED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  ADMISSION
  FEE
  SHOP_ORDER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progressNotes ProgressNote[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  syllabus    String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches    Batch[]
  feePlans   FeePlan[]
  students   Student[]
  admissions Admission[]
  teachers   Teacher[]
}

model Batch {
  id        String   @id @default(cuid())
  classId   String
  name      String
  schedule  String
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class      Class        @relation(fields: [classId], references: [id])
  students   Student[]
  admissions Admission[]
}

model FeePlan {
  id             String   @id @default(cuid())
  classId        String
  name           String
  amount         Int           // amount in paise
  durationMonths Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class      Class       @relation(fields: [classId], references: [id])
  admissions Admission[]
}

model Admission {
  id           String          @id @default(cuid())
  studentName  String
  dob          DateTime?
  guardianName String
  phone        String
  email        String
  address      String?
  classId      String
  batchId      String
  feePlanId    String
  status       AdmissionStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  class   Class    @relation(fields: [classId], references: [id])
  batch   Batch    @relation(fields: [batchId], references: [id])
  feePlan FeePlan  @relation(fields: [feePlanId], references: [id])
  student Student?
  payment Payment?

  @@index([status])
}

model Student {
  id           String    @id @default(cuid())
  name         String
  dob          DateTime?
  email        String
  phone        String
  guardianName String?
  address      String?
  joinedDate   DateTime  @default(now())
  classId      String
  batchId      String
  active       Boolean   @default(true)
  admissionId  String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  class      Class          @relation(fields: [classId], references: [id])
  batch      Batch          @relation(fields: [batchId], references: [id])
  admission  Admission?     @relation(fields: [admissionId], references: [id])
  attendance Attendance[]
  progress   ProgressNote[]
  payments   Payment[]
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model ProgressNote {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @default(now())
  note      String
  rating    Int?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  author  Admin   @relation(fields: [authorId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  amount            Int           // amount in paise
  currency          String        @default("INR")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  status            PaymentStatus @default(CREATED)
  purpose           PaymentPurpose
  admissionId       String?       @unique
  studentId         String?
  orderId           String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  admission Admission? @relation(fields: [admissionId], references: [id])
  student   Student?   @relation(fields: [studentId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int           // amount in paise
  imageUrls   String[]
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id           String      @id @default(cuid())
  buyerName    String
  buyerPhone   String
  buyerEmail   String
  buyerAddress String?
  productId    String
  quantity     Int         @default(1)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product Product  @relation(fields: [productId], references: [id])
  payment Payment?
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  message   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
